        HP = 2,
        ATK = 1,
        DEF = 1,
        SPD = 0.5,
        CRIT = 0.3,
        STA = 0.8,
        ACC = 0.4,
        LUCK = 0.2,
    },
    EvolutionLevels = { 30, 60 }, -- Níveis em que o animal evolui
    TrainingCostPerSession = function(level)
        return math.floor(50 * (1 + level * 0.15))
    end,
    TrainingExpGain = function(level)
        return math.floor(30 + level * 2)
    end,
}

-- ============================================================
-- APOSTAS
-- ============================================================
